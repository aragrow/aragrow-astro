---
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  structuredData?: object | object[];
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'David Arago — Fractional CTO & Technology Leader',
  description = 'David Arago | AraGrow LLC — Fractional CTO services, AI integration, web development, and scalable tech solutions for growing businesses.',
  structuredData,
  noindex = false,
  image = '/logo.png',
  type = 'website',
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? 'https://aragrow.me';
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteImage = image.startsWith('http') ? image : `${siteOrigin}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph (Facebook, LinkedIn, Slack, iMessage, Discord, WhatsApp, etc.) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AraGrow" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:locale" content="en_US" />

    <!-- X/Twitter falls back to og:* tags but explicit summary_large_image gives the big card -->
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Preload critical fonts to eliminate CLS from font-swap -->
    <link rel="preload" href="/fonts/space-grotesk-300-2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-300-6.woff2" as="font" type="font/woff2" crossorigin />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <!-- Analytics scripts (GA/GTM) load via ConsentBanner only after user opt-in -->
  </head>
  <body>
    <slot />
    <ConsentBanner />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<script>
  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => entry.target.classList.add('visible'), i * 80);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  revealEls.forEach((el) => observer.observe(el));
</script>
