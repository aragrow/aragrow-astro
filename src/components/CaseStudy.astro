---
import { type CaseStudy, caseStudies, caseStudyHref } from '../data/case-studies';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const headingId = `${study.id}-title`;
const inProgress = study.status === 'in-progress';
const related = (study.related ?? [])
  .map((id) => caseStudies.find((s) => s.id === id))
  .filter((s) => s !== undefined);
---

<article class="cs-entry" id={study.id} aria-labelledby={headingId}>
  <div class="section-label">{study.label}</div>
  <h2 class="cs-title" id={headingId}>{study.title}</h2>

  <dl class="cs-meta">
    <div>
      <dt>{study.organizationLabel ?? 'Organization'}</dt>
      <dd>{study.organization}</dd>
    </div>
    <div>
      <dt>My role</dt>
      <dd>{study.role}</dd>
    </div>
  </dl>

  <div class="cs-block">
    <h3 class="cs-heading">The problem</h3>
    {study.problem.map((p) => <p>{p}</p>)}
  </div>

  <div class="cs-block">
    <h3 class="cs-heading">{inProgress ? "What we're doing" : 'What we did'}</h3>
    {
      study.whatWeDid.map((p) =>
        typeof p === 'string' ? (
          <p>{p}</p>
        ) : (
          <>
            <p>
              <strong>{p.lead}</strong> {p.text}
            </p>
            {p.items && (
              <ul class="cs-steps">
                {p.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </>
        )
      )
    }
  </div>

  <div class="cs-block">
    <h3 class="cs-heading">{inProgress ? "What we'll measure" : 'The results'}</h3>
    <ul class="cs-results">
      {study.results.map((r) => <li>{r}</li>)}
    </ul>
  </div>

  {
    study.sources && (
      <div class="cs-block">
        <h3 class="cs-heading">Further reading</h3>
        <ul class="cs-sources">
          {study.sources.map((s) => (
            <li>
              <a href={s.href} rel="noopener">{s.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    study.closing && (
      <div class="cs-block">
        {study.closing.map((p) => <p>{p}</p>)}
      </div>
    )
  }

  {
    study.quote && (
      <figure class="cs-quote">
        <blockquote>
          <p>"{study.quote.text}"</p>
        </blockquote>
        <figcaption>{study.quote.attribution}</figcaption>
      </figure>
    )
  }

  {
    related.length > 0 && (
      <p class="cs-offer">
        Related case study:{' '}
        {related.map((s, i) => (
          <>
            {i > 0 && ', '}
            <a href={caseStudyHref(s.id)}>{s.title}</a>
          </>
        ))}
      </p>
    )
  }

</article>

<style>
  .cs-entry {
    margin-bottom: 24px;
    padding: 40px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    scroll-margin-top: 96px;
  }
  .cs-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700; line-height: 1.2;
    color: var(--text);
    margin-bottom: 24px;
  }

  /* ── Organization / role ── */
  .cs-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 32px;
    padding-bottom: 28px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .cs-meta dt {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--teal-text);
    margin-bottom: 4px;
  }
  .cs-meta dd { font-size: 0.92rem; line-height: 1.6; color: var(--muted); }

  /* ── Body blocks ── */
  .cs-block { margin-bottom: 28px; }
  .cs-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem; font-weight: 700;
    color: var(--text); margin-bottom: 12px;
  }
  .cs-block p {
    font-size: 0.95rem; line-height: 1.75;
    color: var(--muted); margin-bottom: 12px;
  }
  .cs-block p strong { color: var(--text); font-weight: 700; }

  /* ── List under a lead-in ── */
  .cs-steps {
    padding-left: 20px; margin: -4px 0 16px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .cs-steps li { font-size: 0.95rem; line-height: 1.65; color: var(--muted); }

  /* ── Results list ── */
  .cs-results {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 12px;
  }
  .cs-results li {
    font-size: 0.95rem; line-height: 1.65;
    color: var(--text);
    padding-left: 24px; position: relative;
  }
  .cs-results li::before {
    content: '✓';
    position: absolute; left: 0;
    color: var(--teal-text); font-weight: 700;
    font-size: 0.85rem; top: 2px;
  }

  /* ── Quote ── */
  .cs-quote {
    padding: 16px 20px;
    background: var(--teal-dim);
    border-left: 3px solid var(--teal-text);
    border-radius: 0 8px 8px 0;
  }
  .cs-quote blockquote p {
    font-size: 1rem; line-height: 1.6;
    font-style: italic; color: var(--text);
  }
  .cs-quote figcaption {
    margin-top: 6px;
    font-size: 0.85rem; color: var(--muted);
  }

  /* ── Further reading ── */
  .cs-sources {
    padding-left: 20px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .cs-sources li { font-size: 0.92rem; line-height: 1.6; color: var(--muted); }
  .cs-sources a {
    color: var(--teal-text);
    text-decoration: underline; text-underline-offset: 2px;
  }
  .cs-sources a:hover { color: var(--teal); }

  /* ── Related case study ── */
  .cs-offer {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.92rem; color: var(--muted);
  }
  .cs-offer a {
    font-weight: 600; color: var(--teal-text);
    text-decoration: underline; text-underline-offset: 2px;
  }
  .cs-offer a:hover { color: var(--teal); }

  @media (max-width: 640px) {
    .cs-entry { padding: 24px 20px; }
    .cs-meta { grid-template-columns: 1fr; }
  }
</style>
