---

<section id="testimonials">
  <div class="container">
    <div class="reveal">
      <div class="section-label">What clients and colleagues say</div>
      <h2 class="section-title">People Who've <span class="grad-text">Done the Work With Me</span></h2>
      <p class="section-sub">
        AraGrow works with a small number of clients at a time. These are real people who have
        worked alongside David as clients, collaborators, and peers.
      </p>
    </div>

    <!-- Carousel -->
    <div class="tc-viewport">
      <div class="tc-track" id="tc-track">
        {testimonials.map((t) => (
          <div class="tc-slide">
            <article class="testimonial-card">
              <div class="testimonial-quote-mark">"</div>
              <blockquote class="testimonial-quote">
                <p>{t.quote}</p>
              </blockquote>
              <footer class="testimonial-footer">
                <div class="testimonial-avatar">
                  {t.avatarUrl && t.avatarHref
                    ? <a href={t.avatarHref} target="_blank" rel="noopener" aria-label={`${t.name} profile`}><img src={t.avatarUrl} alt={t.name} width="40" height="40" loading="lazy" /></a>
                    : t.avatarUrl
                    ? <img src={t.avatarUrl} alt={t.name} width="40" height="40" loading="lazy" />
                    : t.name.charAt(0)
                  }
                </div>
                <div>
                  <div class="testimonial-name">
                    {t.nameHref
                      ? <a href={t.nameHref} target="_blank" rel="noopener">{t.name}</a>
                      : t.name
                    }
                  </div>
                  <div class="testimonial-meta">
                    {t.companyHref
                      ? <a href={t.companyHref} target="_blank" rel="noopener">{t.company}</a>
                      : t.company
                    }
                    {t.location && <>{' · '}{t.location}</>}
                  </div>
                </div>
              </footer>
            </article>
          </div>
        ))}
      </div>
    </div>

    <!-- Controls -->
    <div class="tc-controls">
      <button class="tc-arrow" id="tc-prev" aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="tc-dots" id="tc-dots"></div>
      <button class="tc-arrow" id="tc-next" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  .tc-viewport {
    overflow: hidden;
    margin: 0 -4px;
    padding: 0 4px;
  }
  .tc-track {
    display: flex;
    transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .tc-slide {
    min-width: 50%;
    box-sizing: border-box;
    padding: 0 12px;
    align-self: start;
  }

  /* Controls */
  .tc-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 28px;
  }
  .tc-arrow {
    width: 34px; height: 34px; border-radius: 50%;
    border: 1.5px solid var(--border);
    background: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    color: var(--muted);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    flex-shrink: 0;
  }
  .tc-arrow:hover {
    border-color: var(--teal-text);
    color: var(--teal-text);
    background: var(--teal-dim);
  }
  .tc-dots {
    display: flex; gap: 7px; align-items: center;
  }
  .tc-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--border);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .tc-dot.active {
    background: var(--teal-text);
    transform: scale(1.4);
  }

  @media (max-width: 640px) {
    .tc-slide { min-width: 100%; padding: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-track { transition: none; }
    .tc-dot { transition: none; }
  }
</style>

<script>
  const track = document.getElementById('tc-track') as HTMLElement;
  const dotsContainer = document.getElementById('tc-dots') as HTMLElement;
  const slides = track.querySelectorAll('.tc-slide');
  const total = slides.length;
  const MOBILE_BP = 640;

  let step = window.innerWidth <= MOBILE_BP ? 1 : 2;
  let pageCount = Math.ceil(total / step);
  let current = 0;

  function buildDots() {
    dotsContainer.innerHTML = '';
    for (let i = 0; i < pageCount; i++) {
      const btn = document.createElement('button');
      btn.className = 'tc-dot' + (i === 0 ? ' active' : '');
      btn.setAttribute('aria-label', `Page ${i + 1}`);
      btn.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(btn);
    }
  }

  function goTo(n: number) {
    current = ((n % pageCount) + pageCount) % pageCount;
    track.style.transform = `translateX(-${current * 100}%)`;
    dotsContainer.querySelectorAll('.tc-dot').forEach((d, i) =>
      d.classList.toggle('active', i === current)
    );
  }

  document.getElementById('tc-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('tc-next')?.addEventListener('click', () => goTo(current + 1));

  // Touch swipe
  let touchStartX = 0;
  track.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  track.addEventListener('touchend', (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 48) goTo(current + (diff > 0 ? 1 : -1));
  });

  // Rebuild on resize if breakpoint crossed
  window.addEventListener('resize', () => {
    const newStep = window.innerWidth <= MOBILE_BP ? 1 : 2;
    if (newStep !== step) {
      step = newStep;
      pageCount = Math.ceil(total / step);
      current = 0;
      track.style.transform = 'translateX(0)';
      buildDots();
    }
  });

  buildDots();
</script>
