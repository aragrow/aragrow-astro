<section id="hero">
  <div class="hero-orb hero-orb-1"></div>
  <div class="hero-orb hero-orb-2"></div>
  <div class="container hero-content">
    <h1 class="hero-title">
      Your technology was built for<br />
      <span class="grad-text">the company you were.</span>
    </h1>
    <div class="hero-body">
      <div class="hero-text">
        <p class="hero-sub hero-sub-italic">
          It's not built for the company you're becoming.
        </p>
        <p class="hero-sub">
          I help businesses between $5M and $10M close that gap as their fractional CTO: a senior
          technology leader who works with you part-time, without the cost of a full-time hire.
          I'm David Aragó, and when you reach out, you reach me directly.
        </p>
      </div>
      <div class="hero-action-card">
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Book a 30-minute conversation</a>
        </div>
        <p class="hero-cta-alt">
          <a href="/self-assessment">Take the free self-assessment</a> if you're not ready to book.
        </p>
      </div>
    </div>
    <div class="hero-stats">
      <div>
        <div class="stat-num">25+</div>
        <div class="stat-label">Years Hands-On Experience</div>
      </div>
      <div>
        <div class="stat-num">9</div>
        <div class="stat-label">Major System Migrations</div>
      </div>
      <div>
        <div class="stat-num">EN · ES</div>
        <div class="stat-label">Bilingual</div>
      </div>
    </div>
  </div>
</section>
