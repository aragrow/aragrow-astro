---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">

    <!-- Row 1: Logo + nav links -->
    <div class="footer-top">
      <div class="footer-logo">Ara<span>Grow</span> LLC</div>
      <div class="footer-links">
        <a href="/contact">Contact</a>
        <a href="/privacy/">Privacy</a>
        <a href="/ai-policy/">AI policy</a>
        <a href="/terms/">Terms</a>
        <button type="button" class="footer-link-btn" id="open-consent">Cookie preferences</button>
      </div>
    </div>

    <!-- Row 2: Social icons -->
    <p class="footer-social-label">Connect</p>
    <div class="footer-social" aria-label="Connect with David on social media">
      <a
        href="https://www.linkedin.com/in/davidarago/"
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.35-1.85 3.58 0 4.24 2.36 4.24 5.43v6.31zM5.34 7.43c-1.14 0-2.06-.93-2.06-2.06s.92-2.06 2.06-2.06c1.14 0 2.06.92 2.06 2.06s-.93 2.06-2.06 2.06zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"/>
        </svg>
      </a>
      <a
        href="https://www.facebook.com/david.arago"
        target="_blank"
        rel="noopener"
        aria-label="Facebook"
        title="Facebook"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
      <a
        href="https://www.alignable.com/golden-valley-mn/aragrow-llc?user=13125290"
        target="_blank"
        rel="noopener"
        aria-label="Alignable"
        title="Alignable"
      >
        <span class="footer-social-mark" aria-hidden="true">A</span>
      </a>
    </div>

    <!-- Row 3: Copyright -->
    <p class="footer-copy">© {year} AraGrow LLC · Minneapolis, MN · Serving clients in the US and internationally · EN · ES</p>

  </div>
</footer>

<style>
  .footer-links .footer-link-btn {
    appearance: none; background: none; border: none; padding: 0; margin: 0;
    font: inherit; cursor: pointer;
    font-size: 0.82rem; color: rgba(253,246,244,0.75); text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links .footer-link-btn:hover { color: var(--purple); }
</style>

<script>
  document.getElementById('open-consent')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('aragrow:open-consent'));
  });
</script>
