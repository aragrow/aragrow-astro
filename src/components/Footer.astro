---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-logo">Ara<span>Grow</span> LLC</div>
      <div class="footer-copy">© {year} AraGrow LLC · Minneapolis, MN</div>
      <div class="footer-links">
        <a href="https://aragrow.me" target="_blank" rel="noopener">aragrow.me</a>
        <a href="https://www.linkedin.com/in/davidarago/" target="_blank" rel="noopener"
          >LinkedIn</a
        >
        <a href="#contact">Contact</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/ai-policy/">AI usage policy</a>
        <a href="/terms/">Terms</a>
        <button type="button" class="footer-link-btn" id="open-consent">Cookie preferences</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-links .footer-link-btn {
    appearance: none; background: none; border: none; padding: 0; margin: 0;
    font: inherit; cursor: pointer;
    font-size: 0.82rem; color: var(--muted); text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links .footer-link-btn:hover { color: var(--teal-text); }
</style>

<script>
  document.getElementById('open-consent')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('aragrow:open-consent'));
  });
</script>
