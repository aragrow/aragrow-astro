---
import { caseStudyHref } from '../data/case-studies';

// Each card links to its case study on /case-studies, where the full label (prior role or
// client engagement) is shown. Give a card a `label` to also show a pill here.
// Only the first FEATURED cards show on the homepage; reorder the list to change which ones.
const FEATURED = 3;
const results: { label?: string; headline: string; text: string; href: string }[] = [
  {
    headline: '$125K saved per year. Weekend on-call calls dropped to zero.',
    text: 'Moved 7 high-traffic broadcast websites (5M page views a month) from self-hosting to managed hosting.',
    href: caseStudyHref('broadcasting-managed-hosting'),
  },
  {
    headline: 'About 100 hours saved every month across the company.',
    text: 'Replaced untracked access across 75 business units with a system that has a full audit trail, built by an engineer I mentored into development.',
    href: caseStudyHref('access-control-new-developer'),
  },
  {
    headline: 'Lead developer quit the day after launch. No rollback, no audience impact.',
    text: 'Brought in a part-time senior WordPress developer within hours and structured a four-month handoff, so the team owned the new site within the first month.',
    href: caseStudyHref('developer-resignation-after-launch'),
  },
  {
    headline: 'Live-site failure on the main news site contained in about an hour.',
    text: 'Traced disappearing stories to database load from a new newsroom tool, then brought in a specialist vendor to build a replacement for production traffic and rolled it out to all 7 stations.',
    href: caseStudyHref('newsroom-incident-build-vs-buy'),
  },
  {
    headline: 'One accountable lead for every vendor, from the AP feed to NetSuite.',
    text: 'Owned the hosting, news feed and enterprise system relationships, and brought in specialists only when needed, so problems stopped bouncing between vendors.',
    href: caseStudyHref('vendor-management'),
  },
  {
    headline: 'Team split on a high-risk design. The decision held, and so did the trust.',
    text: "Gave every option a full hearing, made the call with data integrity first and documented it, so the team could bring back the architect's ideas when requirements changed.",
    href: caseStudyHref('team-disagreement-decision'),
  },
  {
    headline: 'A disaster recovery plan with an owner for every step.',
    text: 'Brought the network and development teams together on a recovery plan for 7 news websites, from switching to a standby copy to switching back without losing data.',
    href: caseStudyHref('disaster-recovery-plan'),
  },
];
const featured = results.slice(0, FEATURED);
---

<section id="results">
  <div class="container">
    <div class="reveal">
      <h2 class="section-title">Results</h2>
    </div>
    <div class:list={['results-grid', { 'results-grid-two': featured.length % 3 !== 0 && featured.length % 2 === 0 }]}>
      {
        featured.map((r, i) => (
          <article class="result-card reveal">
            {r.label && <span class="result-label">{r.label}</span>}
            <h3 id={`result-${i}`}>{r.headline}</h3>
            <p>{r.text}</p>
            <a class="result-link" href={r.href} aria-describedby={`result-${i}`}>Read the case study</a>
          </article>
        ))
      }
    </div>
    <p class="results-more">
      <a href="/case-studies" class="btn btn-outline">See all case studies</a>
    </p>
  </div>
</section>

<style>
  #results { padding: 56px 0 72px; }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 24px; margin-top: 32px;
  }
  /* Counts like 4 read better as rows of two than as three plus a remainder */
  @media (min-width: 700px) {
    .results-grid-two { grid-template-columns: repeat(2, 1fr); }
  }
  .result-card {
    display: flex; flex-direction: column;
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 32px;
  }
  .result-label {
    align-self: flex-start;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--teal-text);
    padding: 4px 10px;
    background: var(--teal-dim);
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .result-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem; font-weight: 700; line-height: 1.35;
    color: var(--text); margin-bottom: 12px;
  }
  .result-card p {
    color: var(--muted); font-size: 0.92rem; line-height: 1.7;
    margin-bottom: 20px;
  }
  .result-link {
    margin-top: auto;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem; font-weight: 600;
    color: var(--teal-text);
    text-decoration: underline; text-underline-offset: 2px;
  }
  .result-link:hover { color: var(--teal); }

  .results-more { margin-top: 32px; text-align: center; }
</style>
