---
export interface FaqItem {
  question: string;
  answer: string;
  group?: string;
  // Optional next step shown after the answer.
  link?: { text: string; href: string };
}

interface Props {
  faqs: FaqItem[];
  // Optional sections, in display order; each item's `group` names its section.
  groups?: { id: string; title: string; cta?: { text: string; linkText: string; href: string } }[];
}

const { faqs, groups } = Astro.props;
// Number questions across the whole page so every answer id stays unique.
const numbered = faqs.map((item, i) => ({ ...item, i }));
const sections = groups
  ? groups.map((g) => ({ ...g, items: numbered.filter((f) => f.group === g.id) }))
  : [{ id: '', title: '', cta: undefined, items: numbered }];
---

<section id="faq">
  <div class="container">
    <div class="reveal">
      <div class="section-label">FAQ</div>
      <h1 class="section-title">Frequently Asked <span class="grad-text">Questions</span></h1>
      <p class="section-sub">
        Everything you need to know about working with AraGrow. Can't find your answer?
        <a href="/contact" class="faq-contact-link">Get in touch →</a>
      </p>
    </div>

    {
      groups && (
        <nav class="faq-toc" aria-label="FAQ sections">
          <ul>
            {sections.map((sec) => (
              <li>
                <a href={`#${sec.id}`}>{sec.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      sections.map((sec) => (
        <section class="faq-group" id={sec.id || undefined} aria-labelledby={sec.title ? `${sec.id}-title` : undefined}>
          {sec.title && <h2 class="faq-group-title" id={`${sec.id}-title`}>{sec.title}</h2>}
          <div class="faq-list">
            {sec.items.map((item) => (
                <div class="faq-item reveal">
                  <button class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${item.i}`}>
                    <span>{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">+</span>
                  </button>
                  <div class="faq-answer" id={`faq-answer-${item.i}`} role="region" hidden>
                    {item.answer.split('\n\n').map((para: string) => <p>{para}</p>)}
                    {item.link && (
                      <p class="faq-answer-link">
                        <a href={item.link.href}>{item.link.text}</a>
                      </p>
                    )}
                  </div>
                </div>
            ))}
          </div>
          {sec.cta && (
            <p class="lead-prompt">
              {sec.cta.text} <a href={sec.cta.href}>{sec.cta.linkText}</a>
            </p>
          )}
        </section>
      ))
    }
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.faq-item');

  items.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-question')!;
    const answer = item.querySelector<HTMLElement>('.faq-answer')!;
    const icon = btn.querySelector<HTMLElement>('.faq-icon')!;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      items.forEach((other) => {
        if (other !== item) {
          const otherBtn = other.querySelector<HTMLButtonElement>('.faq-question')!;
          const otherAnswer = other.querySelector<HTMLElement>('.faq-answer')!;
          const otherIcon = other.querySelector<HTMLElement>('.faq-icon')!;
          otherBtn.setAttribute('aria-expanded', 'false');
          otherAnswer.hidden = true;
          otherIcon.textContent = '+';
          other.classList.remove('open');
        }
      });

      // Toggle current
      btn.setAttribute('aria-expanded', String(!isOpen));
      answer.hidden = isOpen;
      icon.textContent = isOpen ? '+' : '×';
      item.classList.toggle('open', !isOpen);
    });
  });
</script>
