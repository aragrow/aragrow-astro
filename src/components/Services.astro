---
import { caseStudyHref } from '../data/case-studies';

const services: {
  icon: string;
  title: string;
  description: string;
  tag: string;
  proof?: string;
  proofHref?: string;
  // Links one phrase inside the description, such as an award, to an outside page.
  descriptionLink?: { text: string; href: string };
}[] = [
  {
    icon: '🧭',
    title: 'Fractional CTO',
    description:
      'Your technology decisions are getting made without anyone who owns the full picture, or they\'re not getting made at all. I bring senior technology leadership (strategy, decisions, roadmap, team oversight) on a part-time basis, catch risks before they become crises, and make sure every significant call has someone accountable behind it. No full-time salary required.',
    tag: 'Leadership · Strategy · Roadmap',
    proof: 'Example: turned an access control audit risk into a system that saves about 100 hours a month.',
    proofHref: caseStudyHref('access-control-new-developer'),
  },
  {
    icon: '🤖',
    title: 'AI Integration',
    description:
      'Most AI advice you\'re getting right now is generic hype that will cost you time and money you don\'t have. I help you figure out which two or three things AI will actually improve in your business, then build only those. Currently developing WrapInsights, an AI-powered analytics platform for non-technical business owners.',
    tag: 'Practical AI · Real Workflows · No Hype',
  },
  {
    icon: '🌐',
    title: 'Web Development',
    description:
      'A site built by an agency you can no longer reach, or that your team can\'t maintain once the invoice is paid, ends up costing more than it saved. I build custom WordPress sites, Laravel applications, and full-stack platforms your team can actually run after the engagement ends, backed by an Emmy Award–winning background in web design and usability.',
    tag: 'WordPress · Laravel · Full-Stack · Emmy-Recognized',
    proof: 'Example: kept a new WordPress site running after its developer resigned the day after launch.',
    proofHref: caseStudyHref('developer-resignation-after-launch'),
  },
  {
    icon: '☁️',
    title: 'Cloud Infrastructure',
    description:
      'A fragile hybrid hosting setup with single points of failure works, until the day it doesn\'t. I\'ve migrated organizations onto managed platforms and deployment pipelines built to grow with the business, cutting overhead and closing off those failure points along the way.',
    tag: 'Oracle Cloud · Managed Hosting · DevOps · Pantheon',
    proof: 'Example: cut hosting costs by about half for 7 broadcast sites.',
    proofHref: caseStudyHref('broadcasting-managed-hosting'),
  },
  {
    icon: '🗄️',
    title: 'Database Management',
    description:
      'The systems your business depends on most, ERP, HRIS, CMS, financial platforms, are usually the ones nobody wants to touch. I\'ve led nine major migrations across exactly those systems, plus the schema design and performance tuning that keeps them reliable once they\'re live.',
    tag: 'Oracle · MySQL · Architecture · Migration',
    proof: 'Example: moved 20 years of finance records into four new systems, with reports ready at launch.',
    proofHref: caseStudyHref('finance-hr-data-migration'),
  },
  {
    icon: '⚡',
    title: 'Web Performance & WebOps',
    description:
      'A slow site your team can\'t update without calling in a developer is costing you both customers and time. I optimize load times, put the right CDN and caching strategy in place, and streamline deployment so routine updates don\'t require a developer on standby. Best in WebOps Award winner (Pantheon, 2023).',
    tag: 'Performance · WebOps · CDN · Uptime',
    descriptionLink: {
      text: 'Best in WebOps Award winner (Pantheon, 2023)',
      href: 'https://pantheon.io/press-releases/pantheon-announces-best-webops-top-20',
    },
    proof: 'Example: kept 7 news sites fast through breaking news traffic spikes.',
    proofHref: caseStudyHref('webops-release-process'),
  },
];
---

<section id="services">
  <div class="container">
    <div class="reveal">
      <div class="section-label">What I Do</div>
      <h2 class="section-title">Hands-On Tech <span class="grad-text">Leadership</span></h2>
      <p class="section-sub">
        Six service areas. One person accountable. I do strategy and execution, no handoffs to
        junior staff.
      </p>
    </div>
    <div class="services-grid">
      {
        services.map((s) => (
          <div class="service-card reveal">
            <div class="service-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            {s.descriptionLink && s.description.includes(s.descriptionLink.text) ? (
              <p>{s.description.split(s.descriptionLink.text)[0]}<a href={s.descriptionLink.href} rel="noopener">{s.descriptionLink.text}</a>{s.description.split(s.descriptionLink.text)[1]}</p>
            ) : (
              <p>{s.description}</p>
            )}
            {s.proof && s.proofHref && (
              <a class="service-proof" href={s.proofHref}>{s.proof}</a>
            )}
            <span class="service-tag">{s.tag}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
