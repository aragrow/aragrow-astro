---
---

<section class="icp-hero" id="icp-hero">
  <div class="icp-hero-bg" aria-hidden="true"></div>
  <div class="container icp-hero-inner">
    <div class="icp-text">
      <p class="icp-eyebrow">Who I work with</p>
      <h2 class="icp-title">
        The right<br />
        <span class="grad-text">fit.</span>
      </h2>

      <p class="icp-fitnote">
        <span class="icp-fitnote-dot" aria-hidden="true"></span>
        <strong>$5M–$10M revenue</strong> · <strong>20–40 people</strong> ·
        no full-time CTO in the room
      </p>

      <ul class="icp-pricing">
        <li>
          <strong>30-day technology audit: up to $3,000.</strong>
          Around 20 hours. Defined scope, specific deliverables, clear picture of where things stand.
          <a href="/30-day-audit" class="icp-pricing-link">See what the audit includes</a>
          <span class="icp-opt-out">14-day opt-out if the engagement isn't the right fit.</span>
        </li>
        <li>
          <strong>Ongoing fractional CTO: $1,500–$3,000/month.</strong>
          Most engagements run 10–20 hours a month, billed at $150/hour, no minimums.
        </li>
        <li class="icp-pricing-nudge">
          Not sure which fits? <a href="/contact">Start with the audit.</a>
        </li>
      </ul>
      <p class="icp-fitnote-escape">
        If you're not an exact fit, <a href="/contact">reach out anyway</a>. I'd rather point you somewhere
        useful than let you keep searching.
      </p>

      <a href="/contact" class="icp-cta">
        Book a 30-minute conversation
        <span class="icp-cta-arrow" aria-hidden="true">→</span>
      </a>
      <p class="icp-cta-alt">
        <a href="/self-assessment">Take the free self-assessment</a> if you're not ready to book.
        · <a href="/how-i-work">See how I work</a>
      </p>
    </div>

    <div class="icp-portrait" aria-hidden="true">
      <div class="icp-portrait-glow"></div>
      <img
        src="/images/david-illustration.svg"
        alt=""
        width="520"
        height="420"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  /* ──────────────── Section ──────────────── */
  .icp-hero {
    position: relative;
    padding: 100px 0 120px;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--border);
  }
  .icp-hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse at 15% 25%, rgba(232,185,49,0.18), transparent 55%),
      radial-gradient(ellipse at 88% 78%, rgba(123,24,24,0.20), transparent 55%),
      linear-gradient(160deg, #fdf6f4 0%, #ffffff 55%, #fff7e6 100%);
  }
  .icp-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(123,24,24,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123,24,24,0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at center, black 25%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 25%, transparent 70%);
  }

  .icp-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  /* ──────────────── Text column ──────────────── */
  .icp-text { max-width: 600px; }

  .icp-eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--teal-text);
    margin: 0 0 18px;
  }

  .icp-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.6rem); font-weight: 700;
    line-height: 1.05; letter-spacing: -0.02em;
    color: var(--text); margin: 0 0 24px;
  }

  /* ──────────────── CTA button ──────────────── */
  .icp-cta {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 28px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.02rem; font-weight: 600;
    padding: 16px 28px; border-radius: 999px;
    background: var(--teal); color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(123,24,24,0.28);
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .icp-cta:hover {
    background: var(--teal-text);
    transform: translateY(-2px);
    box-shadow: 0 10px 22px rgba(123,24,24,0.36);
  }
  .icp-cta:hover .icp-cta-arrow { transform: translateX(4px); }
  .icp-cta-arrow {
    display: inline-block;
    transition: transform 0.2s;
  }
  .icp-cta-alt {
    font-size: 0.88rem; color: var(--muted);
    margin: 14px 0 0;
  }
  .icp-cta-alt a {
    color: var(--teal-text); text-decoration: underline;
    text-underline-offset: 2px;
  }
  .icp-cta-alt a:hover { color: var(--teal); }

  /* ──────────────── Fit note ──────────────── */
  .icp-fitnote {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    margin: 18px 0 0;
    font-size: 0.85rem; color: var(--muted);
  }
  .icp-fitnote strong { color: var(--text); font-weight: 600; }

  .icp-body {
    margin: 18px 0 0;
    font-size: 0.98rem; line-height: 1.65; color: var(--muted);
  }

  .icp-pricing {
    list-style: none; padding: 0; margin: 18px 0 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .icp-pricing li {
    font-size: 0.92rem; line-height: 1.6;
    color: var(--muted);
    padding-left: 20px; position: relative;
  }
  .icp-pricing li::before {
    content: '·';
    position: absolute; left: 6px;
    color: var(--teal-text); font-weight: 700;
  }
  .icp-pricing strong {
    color: var(--text); font-weight: 600;
  }
  .icp-pricing-nudge {
    font-size: 0.88rem !important;
    font-style: italic;
    opacity: 0.85;
  }
  .icp-pricing-nudge a {
    color: var(--teal-text); text-decoration: underline;
    text-underline-offset: 2px; font-style: normal;
  }
  .icp-pricing-nudge a:hover { color: var(--teal); }
  .icp-pricing-nudge::before { content: '' !important; }
  .icp-pricing-link {
    display: inline-block; margin-top: 4px;
    font-size: 0.85rem; font-weight: 600;
    color: var(--teal-text); text-decoration: underline;
    text-underline-offset: 2px;
  }
  .icp-pricing-link:hover { color: var(--teal); }
  .icp-opt-out {
    display: block;
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--muted);
    opacity: 0.8;
    font-style: italic;
  }

  .icp-fitnote-escape {
    margin: 6px 0 0 16px;
    font-size: 0.8rem; line-height: 1.55; color: var(--muted);
    font-style: italic;
    opacity: 0.85;
  }
  .icp-fitnote-escape a {
    color: var(--teal-text); text-decoration: underline;
    text-underline-offset: 2px; font-style: normal;
  }
  .icp-fitnote-escape a:hover { color: var(--teal); }
  .icp-fitnote-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--teal); flex-shrink: 0;
    box-shadow: 0 0 0 4px rgba(123,24,24,0.12);
    animation: icp-pulse 2.4s ease-in-out infinite;
  }
  @keyframes icp-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(123,24,24,0.12); }
    50%      { box-shadow: 0 0 0 8px rgba(123,24,24,0.04); }
  }

  /* ──────────────── Portrait column ──────────────── */
  .icp-portrait {
    position: relative;
    display: flex; justify-content: center; align-items: center;
  }
  .icp-portrait-glow {
    position: absolute; inset: 8% 12%;
    background:
      radial-gradient(circle at 50% 45%, rgba(232,185,49,0.32), rgba(232,185,49,0) 60%),
      radial-gradient(circle at 50% 60%, rgba(123,24,24,0.10), rgba(123,24,24,0) 65%);
    filter: blur(8px);
    z-index: 0;
    border-radius: 50%;
  }
  .icp-portrait img {
    position: relative; z-index: 1;
    width: 100%; max-width: 520px; height: auto;
    /* Tint the black line art toward the brand brown so it reads as illustration, not stock */
    filter: brightness(0) saturate(100%)
            invert(13%) sepia(50%) saturate(2400%) hue-rotate(346deg)
            brightness(80%) contrast(95%);
  }

  /* ──────────────── Responsive ──────────────── */
  @media (max-width: 880px) {
    .icp-hero { padding: 72px 0 88px; }
    .icp-hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .icp-portrait { order: -1; max-width: 360px; margin: 0 auto; }
    .icp-portrait img { max-width: 360px; }
    .icp-text { max-width: 100%; }
  }

  @media (max-width: 480px) {
    .icp-cta { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .icp-cta, .icp-cta-arrow { transition: none; }
    .icp-fitnote-dot { animation: none; }
  }
</style>
