---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getViewablePosts, postState } from '../../lib/posts';
import DraftBadge from '../../components/DraftBadge.astro';
import StickyBadge from '../../components/StickyBadge.astro';
import { existsSync } from 'node:fs';
import sharp from 'sharp';

export async function getStaticPaths() {
  const posts = await getViewablePosts();
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, state: postState(post) },
  }));
}

const { post, state } = Astro.props;
const isDraftPreview = state !== 'published';
const { Content } = await post.render();

const { title, date, modified, author, categories, excerpt, featuredImage, featuredImageAlt, featuredImageCaption } = post.data;
const slug = post.id.replace(/\.md$/, '');

// Width and height keep the page from jumping while the featured image loads.
const featuredFile = featuredImage?.startsWith('/') ? `public${decodeURI(featuredImage)}` : null;
const featuredSize = featuredFile && existsSync(featuredFile) ? await sharp(featuredFile).metadata() : null;

// Front matter dates are plain days; format them in UTC so they don't shift a day back.
const fmtDate = (d) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const formattedDate = fmtDate(date);
// Show an "Updated" date only when the post was changed on a later day than it was posted.
const wasUpdated = modified && modified !== date;
const formattedModified = wasUpdated ? fmtDate(modified) : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt,
  datePublished: date,
  dateModified: modified ?? date,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://aragrow.me',
  },
  publisher: {
    '@type': 'Organization',
    name: 'AraGrow LLC',
    url: 'https://aragrow.me',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://aragrow.me/blog/${slug}`,
  },
  ...(featuredImage ? { image: `https://aragrow.me${featuredImage}` } : {}),

};
---

<Layout
  title={`${title} — AraGrow Blog`}
  description={excerpt}
  structuredData={structuredData}
  type="article"
  image={featuredImage ?? undefined}
>
  <Nav />
  <main>
  <div class="post-wrapper">
    <!-- Hero / header -->
    <header class="post-header">
      <div class="container post-header-inner">
        {
          categories.length > 0 && (
            <div class="post-categories">
              {categories.map((cat) => (
                <span class="post-category-tag">{cat}</span>
              ))}
            </div>
          )
        }
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <StickyBadge sticky={post.data.sticky} />
          <span class="post-author">By: <a href="/#about">{author}</a></span>
          <span class="post-sep">·</span>
          {isDraftPreview ? (
            <DraftBadge state={state} />
          ) : (
            <>
              <time datetime={date}>Posted: {formattedDate}</time>
              {wasUpdated && (
                <>
                  <span class="post-sep">·</span>
                  <time datetime={modified} class="post-updated">Updated: {formattedModified}</time>
                </>
              )}
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Featured image -->
    {
      featuredImage && (
        <div class="container">
          <figure class="post-featured">
            <div class="post-featured-img">
              <img
                src={featuredImage}
                alt={featuredImageAlt ?? ''}
                width={featuredSize?.width}
                height={featuredSize?.height}
                decoding="async"
              />
            </div>
            {featuredImageCaption && <figcaption>{featuredImageCaption}</figcaption>}
          </figure>
        </div>
      )
    }

    <!-- Post body -->
    <div class="container">
      <article class="post-body">
        <Content />
      </article>

      <!-- Back link -->
      <div class="post-back">
        <a href="/blog" class="btn btn-outline">← Back to Blog</a>
        <a href="/#contact" class="btn btn-primary">Work With Me</a>
      </div>
    </div>
  </div>
  </main>

  <Footer />
</Layout>

<style>
  .post-wrapper { padding-top: 80px; padding-bottom: 100px; }

  /* ── Header ── */
  .post-header { padding: 64px 0 40px; }
  .post-header-inner { max-width: 760px; }

  .post-categories { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
  .post-category-tag {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--teal-text);
    background: var(--teal-dim); border: 1px solid var(--border);
    padding: 4px 12px; border-radius: 50px;
  }

  .post-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700; line-height: 1.2;
    color: var(--text); margin-bottom: 20px;
  }

  .post-meta {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.875rem; color: var(--muted);
  }
  .post-author { font-weight: 500; }
  .post-author a { color: inherit; text-decoration: none; border-bottom: 1px dotted currentColor; }
  .post-author a:hover { color: var(--brand, var(--text)); border-bottom-style: solid; }
  .post-sep { opacity: 0.4; }

  /* ── Featured image ── */
  .post-featured { margin: 0 0 48px; }
  .post-featured-img {
    border-radius: var(--radius); overflow: hidden;
    max-height: 480px;
    border: 1px solid var(--border);
  }
  .post-featured-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-featured figcaption {
    font-size: 0.85rem; color: var(--muted);
    text-align: center; margin-top: 12px; font-style: italic;
  }

  /* ── Post body (WordPress HTML content) ── */
  .post-body {
    max-width: 760px;
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text);
  }
  .post-body :global(h2) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.6rem; font-weight: 700;
    margin: 48px 0 16px; color: var(--text);
  }
  .post-body :global(h3) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem; font-weight: 600;
    margin: 32px 0 12px; color: var(--text);
  }
  .post-body :global(p) { margin-bottom: 20px; color: var(--text); }
  .post-body :global(a) { color: var(--teal-text); text-decoration: underline; }
  .post-body :global(ul), .post-body :global(ol) {
    margin: 0 0 20px 24px; color: var(--text);
  }
  .post-body :global(li) { margin-bottom: 8px; line-height: 1.7; }
  .post-body :global(blockquote) {
    border-left: 4px solid var(--teal); margin: 32px 0;
    padding: 16px 24px;
    background: var(--teal-dim); border-radius: 0 8px 8px 0;
    font-style: italic; color: var(--muted);
  }
  .post-body :global(pre) {
    background: #0f172a; color: #e2e8f0;
    padding: 24px; border-radius: 8px;
    overflow-x: auto; margin-bottom: 24px;
    font-size: 0.875rem; line-height: 1.7;
  }
  .post-body :global(code) {
    font-family: 'Fira Code', 'Courier New', monospace;
    background: var(--teal-dim); padding: 2px 6px;
    border-radius: 4px; font-size: 0.875em;
  }
  .post-body :global(pre code) { background: none; padding: 0; }
  .post-body :global(img) {
    max-width: 100%; border-radius: 8px;
    border: 1px solid var(--border); margin: 24px 0;
  }
  .post-body :global(table) {
    width: 100%; border-collapse: collapse; margin-bottom: 24px;
  }
  .post-body :global(th), .post-body :global(td) {
    padding: 10px 14px; border: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .post-body :global(th) { background: var(--teal-dim); font-weight: 600; }
  .post-body :global(figure) { margin: 24px 0; }
  .post-body :global(figcaption) {
    font-size: 0.8rem; color: var(--muted);
    text-align: center; margin-top: 8px;
  }

  /* ── Back / CTA ── */
  .post-back {
    display: flex; gap: 16px; flex-wrap: wrap;
    margin-top: 64px; padding-top: 40px;
    border-top: 1px solid var(--border);
  }
</style>
