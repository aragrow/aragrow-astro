---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LeadClose from '../components/LeadClose.astro';
import { reviews, reviewCategories, reviewHref } from '../data/reviews';

const groupPrompts: Record<string, { text: string; linkText: string; href: string }> = {
  change: { text: 'Planning something big and not sure where to start?', linkText: 'Book a 30-minute conversation', href: '/contact' },
  risk: { text: 'Not sure which risk is biggest for you?', linkText: 'Take the free self-assessment', href: '/self-assessment' },
};

const groups = reviewCategories.map((c) => ({
  ...c,
  items: reviews.filter((r) => r.category === c.id),
}));

const site = Astro.site ?? new URL('https://aragrow.me');
const provider = { '@type': 'Organization', name: 'AraGrow LLC', url: site.href };
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Services',
  url: new URL('/services/', site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: reviews.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: r.name,
        description: r.summary,
        url: new URL(`${reviewHref(r.slug)}/`, site).href,
        areaServed: 'US',
        provider,
        offers: { '@type': 'Offer', price: r.price.replace(/[^0-9.]/g, ''), priceCurrency: 'USD' },
      },
    })),
  },
};
---

<Layout
  title="Services | AraGrow LLC"
  description="Fixed-price reviews for one specific technology problem, from data migrations and hosting costs to access control and disaster recovery. Prices from $1,200."
  structuredData={structuredData}
>
  <Nav />
  <main class="sv-page">

    <!-- Header -->
    <div class="sv-header">
      <div class="container">
        <div class="section-label">Fixed-price reviews</div>
        <h1 class="sv-title">Services</h1>
        <p class="sv-intro">
          Each review answers one specific question, at a set price and scope, so you know the
          cost before we start. If it shows you need more, the 30-day audit or an ongoing
          engagement is the next step.
        </p>
      </div>
    </div>

    <div class="container sv-container">
      {
        groups.map((g) => (
          <section class="sv-group" aria-labelledby={`sv-${g.id}`}>
            <h2 class="sv-group-title" id={`sv-${g.id}`}>{g.title}</h2>
            <p class="sv-group-intro">{g.intro}</p>
            <div class="sv-grid">
              {g.items.map((r) => (
                <article class="sv-card">
                  <h3 class="sv-card-title">{r.name}</h3>
                  <p class="sv-card-for">{r.summary}</p>
                  <ul class="sv-card-list">
                    {r.deliverables.map((d) => <li>{d}</li>)}
                  </ul>
                  <p class="sv-card-price">
                    {r.price} <span>· {r.scope}</span>
                  </p>
                  <a href={reviewHref(r.slug)} class="sv-card-link">See the {r.name}</a>
                </article>
              ))}
            </div>
            {groupPrompts[g.id] && (
              <p class="lead-prompt">
                {groupPrompts[g.id].text} <a href={groupPrompts[g.id].href}>{groupPrompts[g.id].linkText}</a>
              </p>
            )}
          </section>
        ))
      }

      <LeadClose
        title="Not sure which one fits?"
        body="Tell me what you're dealing with, and I'll tell you which review fits, or whether you need one at all."
        links={[
          { text: 'See the 30-day technology audit', href: '/30-day-audit' },
          { text: 'Take the free self-assessment', href: '/self-assessment' },
        ]}
      />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ── Header ── */
  .sv-header {
    background: linear-gradient(160deg, #5a1010 0%, #4a0c0c 55%, #3b0a0a 100%);
    color: #fdf6f4;
    padding: 80px 0 60px;
  }
  .sv-header .section-label { color: #E8B931; }
  .sv-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700; line-height: 1.1;
    color: #fdf6f4; margin: 12px 0 20px;
  }
  .sv-intro {
    font-size: 1rem; line-height: 1.7;
    color: rgba(253,246,244,0.8);
    max-width: 640px;
  }

  /* ── Groups ── */
  .sv-container { padding-top: 56px; padding-bottom: 80px; }
  .sv-group { margin-bottom: 56px; }
  .sv-group-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700; line-height: 1.2;
    color: var(--text); margin-bottom: 8px;
  }
  .sv-group-intro {
    font-size: 0.97rem; line-height: 1.7;
    color: var(--muted); max-width: 640px;
    margin-bottom: 24px;
  }

  /* ── Cards ── */
  .sv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .sv-card {
    display: flex; flex-direction: column;
    padding: 28px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
  }
  .sv-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem; font-weight: 700; line-height: 1.3;
    color: var(--text); margin-bottom: 8px;
  }
  .sv-card-for {
    font-size: 0.9rem; line-height: 1.6;
    color: var(--muted); margin-bottom: 16px;
  }
  .sv-card-list {
    list-style: none; padding: 0; margin: 0 0 20px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .sv-card-list li {
    font-size: 0.88rem; line-height: 1.55; color: var(--text);
    padding-left: 20px; position: relative;
  }
  .sv-card-list li::before {
    content: '✓';
    position: absolute; left: 0;
    color: var(--teal-text); font-weight: 700; font-size: 0.8rem;
  }
  .sv-card-price {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem; font-weight: 700;
    color: var(--teal-text);
  }
  .sv-card-price span {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem; font-weight: 400; color: var(--muted);
  }
  .sv-card-link {
    margin-top: 12px;
    font-size: 0.9rem; font-weight: 600;
    color: var(--teal-text);
    text-decoration: underline; text-underline-offset: 2px;
  }
  .sv-card-link:hover { color: var(--teal); }

  @media (max-width: 640px) {
    .sv-card { padding: 24px 20px; }
  }
</style>
