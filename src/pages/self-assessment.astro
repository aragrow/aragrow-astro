---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// GoHighLevel survey "Technology Self-Assessment". Questions, CAPTCHA, the thank-you message and
// the follow-up workflow all live in GoHighLevel; edit them there, not here.
// The embed's data-cookie-consent attributes are left off on purpose: GoHighLevel hides the survey
// until a recognized consent tool reports consent, and this site's custom banner never does.
const SURVEY_ID = '71ECKGIKna2YcrzIaxKR';
const SURVEY_URL = `https://api.leadconnectorhq.com/widget/survey/${SURVEY_ID}`;
---

<Layout
  title="Technology Self-Assessment | AraGrow LLC"
  description="A free 5-minute self-assessment for growing businesses ($5M–$10M revenue). Understand the state of your technology before your first conversation with David Aragó."
>
  <Nav />
  <main class="sa-page">

    <!-- Header -->
    <div class="sa-header">
      <div class="container">
        <div class="section-label">Free resource</div>
        <h1 class="sa-title">Find the technology risks you've been working around</h1>
        <p class="sa-intro">
          Twenty-four questions, about 5 minutes. They cover how your systems connect, what happens if a
          key person leaves and who actually owns technology decisions: the things a CTO checks first.
        </p>
        <p class="sa-intro sa-intro-next">
          Your answers go to David before your first conversation, so the call starts on your real
          situation instead of background questions.
        </p>
      </div>
    </div>

    <!-- Survey -->
    <div class="container sa-container">
      <p class="sa-note">
        Your answers go straight to David. Keep them general: no passwords, server names or other
        sensitive details.
      </p>
      <div class="sa-survey">
        <iframe
          src={SURVEY_URL}
          style="border:none;width:100%;display:block;min-height:640px;"
          scrolling="no"
          id={SURVEY_ID}
          title="Technology self-assessment"
        ></iframe>
        <noscript>
          <p class="sa-note">
            The assessment needs JavaScript. <a href={SURVEY_URL}>Open it in a new page</a> instead.
          </p>
        </noscript>
      </div>
    </div>

  </main>
  <Footer />
</Layout>

<script>
  // Load GoHighLevel's embed script (it sizes the iframe to the survey) once the survey is near
  // the viewport, the same way the contact form does.
  const survey = document.querySelector<HTMLIFrameElement>('.sa-survey iframe');
  if (survey) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        const s = document.createElement('script');
        s.src = 'https://link.msgsndr.com/js/form_embed.js';
        s.defer = true;
        document.body.appendChild(s);
        io.disconnect();
      },
      { rootMargin: '200px' }
    );
    io.observe(survey);
  }
</script>

<style>
  /* ── Page header ── */
  .sa-header {
    background: linear-gradient(160deg, #5a1010 0%, #4a0c0c 55%, #3b0a0a 100%);
    color: #fdf6f4;
    padding: 80px 0 60px;
  }
  .sa-header .section-label { color: #E8B931; }
  .sa-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700; line-height: 1.1;
    color: #fdf6f4; margin: 12px 0 20px;
  }
  .sa-intro {
    font-size: 1rem; line-height: 1.7;
    color: rgba(253,246,244,0.8);
    max-width: 600px;
  }
  .sa-intro-next { margin-top: 12px; }

  /* ── Survey ── */
  .sa-container { padding-top: 48px; padding-bottom: 80px; }
  .sa-note {
    max-width: 760px; margin: 0 auto 20px;
    font-size: 0.9rem; line-height: 1.6; color: var(--muted);
  }
  .sa-note a { color: var(--teal-text); text-decoration: underline; }
  .sa-survey {
    max-width: 760px; margin: 0 auto;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  @media (max-width: 640px) {
    .sa-survey { padding: 0; border: none; background: none; }
  }
</style>
