---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Pitch 1 — One Team, Full Journey | AraGrow + Evrig + Content Cucumber"
  description="Three specialized firms, one coordinated team — taking you from zero to a live, performing website without the chaos."
  noindex={true}
>
  <Nav />
  <main>
    <!-- ─────────────────────────── HERO ─────────────────────────── -->
    <section class="pitch-hero">
      <div class="pitch-hero-bg" aria-hidden="true"></div>
      <div class="container pitch-hero-inner">
        <p class="pitch-eyebrow">
          <a href="/elevator-pitch/">← All pitches</a> · Pitch 1 — The complete-solution angle
        </p>
        <h1 class="pitch-title">
          One Team.<br />
          <span class="grad-text">Full Journey.</span>
        </h1>
        <p class="pitch-lede">
          Three specialized firms working as a single, coordinated team — taking you from zero to a
          live, performing website without the chaos.
        </p>
        <p class="pitch-tag">Strategy. Build. Content. Live.</p>
      </div>
    </section>

    <!-- ─────────────────────────── BODY ─────────────────────────── -->
    <section class="pitch-body">
      <div class="container pitch-body-inner">
        <div class="pitch-problem">
          <h2>The problem most businesses don't see coming</h2>
          <p>
            Most businesses launching a website have to manage three separate relationships: a
            developer, a content writer, and someone to make sure the technology actually serves the
            business. The handoffs between them create delays, miscommunication, and gaps that kill
            momentum.
          </p>
          <p>
            <strong>We've solved that.</strong> AraGrow, Evrig, and Content Cucumber are three
            specialized firms that work together as a single, coordinated team.
          </p>
        </div>

        <div class="pitch-partners">
          <article class="pitch-partner">
            <div class="pitch-partner-label">Build</div>
            <h3>Evrig</h3>
            <p>
              Engineers the platform. Whether it's Magento, Adobe Commerce, Shopify, or BigCommerce,
              they build high-performance stores that are built to scale — led by a two-time Magento
              Master.
            </p>
          </article>

          <article class="pitch-partner pitch-partner--accent">
            <div class="pitch-partner-label">Strategy</div>
            <h3>AraGrow</h3>
            <p>
              Brings the strategic technology layer: AI integration, cloud infrastructure, and
              fractional CTO-level leadership to make sure every decision aligns with your business
              goals.
            </p>
          </article>

          <article class="pitch-partner">
            <div class="pitch-partner-label">Content</div>
            <h3>Content Cucumber</h3>
            <p>
              Fills the site with content that actually works — human-written, SEO-optimized, and
              designed to build traffic from day one.
            </p>
          </article>
        </div>

        <div class="pitch-close">
          <p class="pitch-close-tag">Strategy. Build. Content. Live.</p>
          <p class="pitch-close-line">That's our system. One conversation starts all three.</p>
          <a href="/contact" class="pitch-cta">Start the conversation →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ──────────────── HERO (pure CSS — no images, sub-250ms paint) ──────────────── */
  .pitch-hero {
    position: relative;
    min-height: 88vh;
    display: flex; align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
    isolation: isolate;
  }
  .pitch-hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse at 18% 24%, rgba(232,185,49,0.18), transparent 55%),
      radial-gradient(ellipse at 82% 78%, rgba(123,24,24,0.22), transparent 55%),
      linear-gradient(135deg, #fdf6f4 0%, #ffffff 60%, #fff7e6 100%);
  }
  .pitch-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(123,24,24,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(123,24,24,0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }

  .pitch-hero-inner { position: relative; }

  .pitch-eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.78rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--teal-text);
    margin: 0 0 18px;
  }
  .pitch-eyebrow a {
    color: var(--muted); text-decoration: none;
    border-bottom: 1px dotted currentColor;
    margin-right: 6px;
  }
  .pitch-eyebrow a:hover { color: var(--teal-text); }

  .pitch-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 700;
    line-height: 1.05; color: var(--text);
    margin: 0 0 24px; letter-spacing: -0.02em;
  }
  .pitch-lede {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.5; color: var(--text);
    margin: 0 0 28px; max-width: 680px;
  }
  .pitch-tag {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem; font-weight: 600;
    letter-spacing: 0.04em; color: var(--teal-text);
    padding: 8px 16px; border-radius: 999px;
    background: rgba(123,24,24,0.08);
    border: 1px solid rgba(123,24,24,0.15);
    margin: 0;
  }

  /* ──────────────── BODY ──────────────── */
  .pitch-body { padding: 80px 0 100px; background: var(--bg, #fff); }
  .pitch-body-inner { max-width: 1000px; }

  .pitch-problem { max-width: 760px; margin: 0 0 64px; }
  .pitch-problem h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem); font-weight: 600;
    color: var(--text); margin: 0 0 18px; line-height: 1.25;
  }
  .pitch-problem p {
    font-size: 1.05rem; line-height: 1.7; color: var(--text);
    margin: 0 0 16px;
  }

  .pitch-partners {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px; margin-bottom: 72px;
  }
  .pitch-partner {
    background: #fff; border: 1px solid var(--border);
    border-radius: 14px; padding: 28px 24px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .pitch-partner:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px -16px rgba(123,24,24,0.20);
    border-color: var(--teal-text);
  }
  .pitch-partner--accent {
    background: linear-gradient(160deg, rgba(123,24,24,0.04), rgba(232,185,49,0.06));
    border-color: rgba(123,24,24,0.18);
  }
  .pitch-partner-label {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--teal-text);
    padding: 4px 10px; border-radius: 6px;
    background: rgba(232,185,49,0.18);
    margin-bottom: 14px;
  }
  .pitch-partner h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.35rem; font-weight: 600; color: var(--text);
    margin: 0 0 10px;
  }
  .pitch-partner p {
    font-size: 0.95rem; line-height: 1.65; color: var(--muted);
    margin: 0;
  }

  .pitch-close { text-align: center; }
  .pitch-close-tag {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem); font-weight: 600;
    color: var(--text); margin: 0 0 8px; letter-spacing: -0.01em;
  }
  .pitch-close-line {
    font-size: 1.05rem; color: var(--muted);
    margin: 0 0 28px;
  }
  .pitch-cta {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem; font-weight: 600;
    padding: 14px 28px; border-radius: 999px;
    background: var(--teal); color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(123,24,24,0.25);
    transition: background 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .pitch-cta:hover {
    background: var(--teal-text);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(123,24,24,0.35);
  }

  @media (max-width: 720px) {
    .pitch-hero { min-height: 78vh; padding-top: 100px; }
  }
</style>
