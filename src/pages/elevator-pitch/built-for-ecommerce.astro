---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Pitch 3 — Built for Ecommerce | AraGrow + Evrig + Content Cucumber"
  description="A three-firm partnership purpose-built for ecommerce brands: platform, strategy, and content — all coordinated, all commerce-focused."
  noindex={true}
>
  <Nav />
  <main>
    <!-- ─────────────────────────── HERO ─────────────────────────── -->
    <section class="pitch-hero">
      <div class="pitch-hero-bg" aria-hidden="true"></div>
      <div class="container pitch-hero-inner">
        <p class="pitch-eyebrow">
          <a href="/elevator-pitch/">← All pitches</a> · Pitch 3 — Ecommerce brand angle
        </p>
        <h1 class="pitch-title">
          Built for<br />
          <span class="grad-text">Ecommerce.</span>
        </h1>
        <p class="pitch-lede">
          A three-firm partnership purpose-built for commerce brands — platform, strategy, and
          content, all coordinated and all commerce-focused.
        </p>
        <p class="pitch-tag">Built for commerce. Built to scale.</p>
      </div>
    </section>

    <!-- ─────────────────────────── BODY ─────────────────────────── -->
    <section class="pitch-body">
      <div class="container pitch-body-inner">
        <div class="pitch-problem">
          <h2>An ecommerce site is never "just a website"</h2>
          <p>
            If you're running or launching an ecommerce brand, you already know this: your site is
            your store, your brand, your customer service rep, and your top salesperson — all in
            one. Getting it wrong is expensive.
          </p>
          <p>
            <strong>Our three-firm partnership was built specifically for ecommerce.</strong>
          </p>
        </div>

        <div class="pitch-partners">
          <article class="pitch-partner">
            <div class="pitch-partner-label">Platform</div>
            <h3>Evrig</h3>
            <p>
              A Magento Master-led agency with 11+ years in Magento, Adobe Commerce, and Hyva. They
              build stores that handle real volume and real growth.
            </p>
          </article>

          <article class="pitch-partner pitch-partner--accent">
            <div class="pitch-partner-label">Strategy</div>
            <h3>AraGrow</h3>
            <p>
              Fractional CTO leadership, AI-powered automation, and the cloud infrastructure to
              keep those stores fast, secure, and scalable.
            </p>
          </article>

          <article class="pitch-partner">
            <div class="pitch-partner-label">Content</div>
            <h3>Content Cucumber</h3>
            <p>
              30+ years of commerce content experience — product descriptions, SEO blog content,
              email programs, and category pages written by real humans who understand how buyers
              think.
            </p>
          </article>
        </div>

        <div class="pitch-trust">
          <p>
            Separately, we're each strong in our lane. Together, we cover the full lifecycle —
            platform build, technology strategy, and content engine — all coordinated, all
            commerce-focused.
          </p>
        </div>

        <div class="pitch-close">
          <p class="pitch-close-tag">Migrating, launching, or growing?</p>
          <p class="pitch-close-line">
            Let us walk you through what an end-to-end commerce partnership looks like.
          </p>
          <a href="/contact" class="pitch-cta">Book a walkthrough →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* ──────────────── HERO (pure CSS — no images, sub-250ms paint) ──────────────── */
  .pitch-hero {
    position: relative;
    min-height: 88vh;
    display: flex; align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
    isolation: isolate;
  }
  /* Pitch 3 variant: warm "storefront" feel — gold top-center, sangria base-right */
  .pitch-hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(232,185,49,0.22), transparent 50%),
      radial-gradient(ellipse at 90% 100%, rgba(123,24,24,0.20), transparent 55%),
      linear-gradient(180deg, #fff7e6 0%, #ffffff 45%, #fdf6f4 100%);
  }
  /* Slightly different texture: diagonal lines instead of grid, for variation */
  .pitch-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(
        45deg,
        transparent 0,
        transparent 38px,
        rgba(123,24,24,0.04) 38px,
        rgba(123,24,24,0.04) 39px
      );
    mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
  }

  .pitch-hero-inner { position: relative; }

  .pitch-eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.78rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--teal-text);
    margin: 0 0 18px;
  }
  .pitch-eyebrow a {
    color: var(--muted); text-decoration: none;
    border-bottom: 1px dotted currentColor;
    margin-right: 6px;
  }
  .pitch-eyebrow a:hover { color: var(--teal-text); }

  .pitch-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 700;
    line-height: 1.05; color: var(--text);
    margin: 0 0 24px; letter-spacing: -0.02em;
  }
  .pitch-lede {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    line-height: 1.5; color: var(--text);
    margin: 0 0 28px; max-width: 680px;
  }
  .pitch-tag {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem; font-weight: 600;
    letter-spacing: 0.04em; color: var(--teal-text);
    padding: 8px 16px; border-radius: 999px;
    background: rgba(123,24,24,0.08);
    border: 1px solid rgba(123,24,24,0.15);
    margin: 0;
  }

  /* ──────────────── BODY ──────────────── */
  .pitch-body { padding: 80px 0 100px; background: var(--bg, #fff); }
  .pitch-body-inner { max-width: 1000px; }

  .pitch-problem { max-width: 760px; margin: 0 0 64px; }
  .pitch-problem h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem); font-weight: 600;
    color: var(--text); margin: 0 0 18px; line-height: 1.25;
  }
  .pitch-problem p {
    font-size: 1.05rem; line-height: 1.7; color: var(--text);
    margin: 0 0 16px;
  }

  .pitch-partners {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px; margin-bottom: 48px;
  }
  .pitch-partner {
    background: #fff; border: 1px solid var(--border);
    border-radius: 14px; padding: 28px 24px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .pitch-partner:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px -16px rgba(123,24,24,0.20);
    border-color: var(--teal-text);
  }
  .pitch-partner--accent {
    background: linear-gradient(160deg, rgba(123,24,24,0.04), rgba(232,185,49,0.06));
    border-color: rgba(123,24,24,0.18);
  }
  .pitch-partner-label {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--teal-text);
    padding: 4px 10px; border-radius: 6px;
    background: rgba(232,185,49,0.18);
    margin-bottom: 14px;
  }
  .pitch-partner h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.35rem; font-weight: 600; color: var(--text);
    margin: 0 0 10px;
  }
  .pitch-partner p {
    font-size: 0.95rem; line-height: 1.65; color: var(--muted);
    margin: 0;
  }

  .pitch-trust {
    max-width: 760px; margin: 0 auto 64px;
    padding: 24px 28px;
    background: linear-gradient(160deg, rgba(232,185,49,0.10), rgba(123,24,24,0.05));
    border: 1px solid rgba(123,24,24,0.15);
    border-radius: 12px;
    text-align: center;
  }
  .pitch-trust p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem; font-weight: 500;
    color: var(--text); line-height: 1.55;
    margin: 0;
  }

  .pitch-close { text-align: center; }
  .pitch-close-tag {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem); font-weight: 600;
    color: var(--text); margin: 0 0 8px; letter-spacing: -0.01em;
  }
  .pitch-close-line {
    font-size: 1.05rem; color: var(--muted);
    margin: 0 0 28px;
  }
  .pitch-cta {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem; font-weight: 600;
    padding: 14px 28px; border-radius: 999px;
    background: var(--teal); color: #fff;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(123,24,24,0.25);
    transition: background 0.18s, transform 0.18s, box-shadow 0.18s;
  }
  .pitch-cta:hover {
    background: var(--teal-text);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(123,24,24,0.35);
  }

  @media (max-width: 720px) {
    .pitch-hero { min-height: 78vh; padding-top: 100px; }
  }
</style>
