---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CaseStudy from '../components/CaseStudy.astro';
import { caseStudies, caseStudyGroups, caseStudyHref } from '../data/case-studies';

const groups = caseStudyGroups.map((g) => ({
  ...g,
  studies: g.ids.map((id) => {
    const study = caseStudies.find((s) => s.id === id);
    if (!study) throw new Error(`Case study group "${g.id}" lists unknown id "${id}"`);
    return study;
  }),
}));
const grouped = new Set(caseStudyGroups.flatMap((g) => g.ids));
const ungrouped = caseStudies.filter((s) => !grouped.has(s.id)).map((s) => s.id);
if (ungrouped.length) throw new Error(`Case studies missing from a group: ${ungrouped.join(', ')}`);

const site = Astro.site ?? new URL('https://aragrow.me');
const author = { '@type': 'Person', name: 'David Arago', url: site.href };
const publisher = { '@type': 'Organization', name: 'AraGrow LLC', url: site.href };

// Schema.org has no case study type; Article is the usual choice. Built from the data file,
// so new case studies are included automatically.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Case Studies',
  url: new URL('/case-studies/', site).href,
  publisher,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: caseStudies.map((study, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: study.title,
        description: study.problem[0],
        url: new URL(caseStudyHref(study.id), site).href,
        author,
        publisher,
      },
    })),
  },
};
---

<Layout
  title="Case Studies | AraGrow LLC"
  description="Fractional CTO case studies with measurable results, including $125K a year saved by moving 7 broadcast websites to managed hosting."
  structuredData={structuredData}
>
  <Nav />
  <main class="cs-page">

    <!-- Header -->
    <div class="cs-header">
      <div class="container">
        <div class="section-label">Proof</div>
        <h1 class="cs-page-title">Case Studies</h1>
        <p class="cs-intro">
          Real problems, real numbers. Each case study is labeled as a client engagement or a prior role.
        </p>
        <p class="cs-intro cs-intro-context">
          The prior-role case studies come from my time as a development team lead. With no CTO in
          place, the network manager and I shared that role.
        </p>
      </div>
    </div>

    <div class="container cs-container">
      <nav class="cs-toc" aria-label="Case study sections">
        <ul>
          {groups.map((g) => (
            <li>
              <a href={`#${g.id}`}>{g.title}</a> <span>({g.studies.length})</span>
            </li>
          ))}
        </ul>
      </nav>

      {
        groups.map((g) => (
          <section class="cs-group" id={g.id} aria-labelledby={`${g.id}-title`}>
            <h2 class="cs-group-title" id={`${g.id}-title`}>{g.title}</h2>
            <p class="cs-group-intro">{g.intro}</p>
            {g.studies.map((study) => <CaseStudy study={study} level={3} />)}
          </section>
        ))
      }

      <!-- CTA -->
      <section class="cs-cta-block" aria-labelledby="cs-cta-title">
        <h2 class="cs-cta-title" id="cs-cta-title">Want to know if this applies to you?</h2>
        <a href="/contact" class="btn btn-primary">Book a 30-minute conversation</a>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ── Header ── */
  .cs-header {
    background: linear-gradient(160deg, #5a1010 0%, #4a0c0c 55%, #3b0a0a 100%);
    color: #fdf6f4;
    padding: 80px 0 60px;
  }
  .cs-header .section-label { color: #E8B931; }
  .cs-page-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700; line-height: 1.1;
    color: #fdf6f4; margin: 12px 0 20px;
  }
  .cs-intro {
    font-size: 1rem; line-height: 1.7;
    color: rgba(253,246,244,0.8);
    max-width: 600px;
  }

  .cs-intro-context { margin-top: 12px; }

  /* ── Container ── */
  .cs-container { padding-top: 56px; padding-bottom: 80px; }

  /* ── Section index ── */
  .cs-toc { margin-bottom: 40px; }
  .cs-toc ul {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .cs-toc a {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.88rem; font-weight: 600;
    color: var(--teal-text);
    padding: 8px 14px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
  }
  .cs-toc a:hover { border-color: var(--teal-text); background: var(--teal-dim); }
  .cs-toc span { font-size: 0.8rem; color: var(--muted); }

  /* ── Groups ── */
  .cs-group { margin-bottom: 48px; scroll-margin-top: 96px; }
  .cs-group-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700; line-height: 1.2;
    color: var(--text);
    margin-bottom: 8px;
  }
  .cs-group-intro {
    font-size: 0.97rem; line-height: 1.7;
    color: var(--muted);
    max-width: 640px;
    margin-bottom: 24px;
  }

  /* ── CTA block ── */
  .cs-cta-block {
    text-align: center;
    padding: 48px 24px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
  }
  .cs-cta-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 700; line-height: 1.25;
    color: var(--text);
    margin-bottom: 24px;
  }

  @media (max-width: 640px) {
    .cs-cta-block { padding: 36px 20px; }
  }
</style>
